# Required for the Agent SDK reviewer
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GITHUB_REVIEW_BOT_TOKEN=ghp_your_bot_users_personal_access_token

# Required for the Learnings layer (Phase 6) — strictly additive;
# the reviewer keeps running if these are missing or unreachable.
VOYAGE_API_KEY=your_voyage_api_key_here
QDRANT_URL=https://your-cluster.us-west-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key_here

# Optional — Jev (TypeSafe System One). With a key set, Jev classifies and
# re-sorts retrieved learnings and screens free-form @mentions; without
# it Haiku judges, as before.
# TYPESAFE_API_KEY=your_typesafe_api_key_here
# LEARNINGS_JUDGE=haiku keeps Haiku even with a key set.
# LEARNINGS_JUDGE=auto
# Starting points, not tuned (see THRESHOLDS in learnings/jev_judge.py):
# LEARNINGS_JEV_APPLIES_MIN=0.30     # below: learning left out of the prompt
# LEARNINGS_JEV_INJECTION_MAX=0.70   # above: never reaches the prompt / stored
# LEARNINGS_JEV_LEARNING_MIN=0.50    # at or above: free-form mention is stored

# Optional — per-PR model routing (Phase 7). With TYPESAFE_API_KEY set, one
# Jev call per PR picks the reviewer's model + effort; without it every PR
# gets the reviewer's default (claude-opus-4-7, effort=max), as before.
# Tiers are "model:effort". Point all three at one model to route effort only.
# ROUTER_TIER_LIGHT=claude-haiku-5-5:medium
# ROUTER_TIER_STANDARD=claude-sonnet-5-5:high
# ROUTER_TIER_DEEP=claude-opus-4-7:max
# Highest accepted chance that a PR needs a deeper tier than it gets.
# ROUTER_RISK=0.15
# ROUTER_MAX_DIFF_CHARS=24000
# ROUTER_TIMEOUT=10

# Optional — impact selection (Phase 8). Bounds the callers/callees section
# of build_review_context. jev = Jev picks what to show (default when
# TYPESAFE_API_KEY is set); cap = fixed order, no Jev (default otherwise);
# off = the pre-Phase-8 context, unbounded.
# IMPACT_SELECT=jev
# IMPACT_KEEP=0.5              # Jev probability for a full snippet
# IMPACT_MENTION=0.2           # ... for a one-line signature; below: counted
# IMPACT_MAX_CHARS=12000       # budget for full snippets
# IMPACT_MAX_SIGNATURES=20
# CONTEXT_MAX_CHARS=60000      # above this, drop the changed-code snippets
# IMPACT_SELECT_TIMEOUT=10     # seconds for all Jev requests together

# Optional Learnings tunables (sane defaults applied if unset; see
# learnings/config.py for the full list).
# LEARNINGS_HANDLE=@Working-Ant
# LEARNINGS_CALL_WORDS=learn,remember,note,teach
# LEARNINGS_THRESHOLD=0.78
# LEARNINGS_TOP_K=5
# LEARNINGS_PER_QUERY_K=5
# LEARNINGS_FILTER=1
# LEARNINGS_INTERVAL=60
