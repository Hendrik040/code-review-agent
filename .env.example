# Required for the Agent SDK reviewer
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GITHUB_REVIEW_BOT_TOKEN=ghp_your_bot_users_personal_access_token

# Required for the Learnings layer (Phase 6) — strictly additive;
# the reviewer keeps running if these are missing or unreachable.
VOYAGE_API_KEY=your_voyage_api_key_here
QDRANT_URL=https://your-cluster.us-west-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key_here

# Optional — per-PR model routing (Phase 7). With a key set, one Jev call
# per PR picks the reviewer's model + effort; without it every PR gets the
# reviewer's default (claude-opus-4-7, effort=max), as before.
# TYPESAFE_API_KEY=your_typesafe_api_key_here
# Tiers are "model:effort". Point all three at one model to route effort only.
# ROUTER_TIER_LIGHT=claude-haiku-5-5:medium
# ROUTER_TIER_STANDARD=claude-sonnet-5-5:high
# ROUTER_TIER_DEEP=claude-opus-4-7:max
# Highest accepted chance that a PR needs a deeper tier than it gets.
# ROUTER_RISK=0.15
# ROUTER_MAX_DIFF_CHARS=24000
# ROUTER_TIMEOUT=10

# Optional Learnings tunables (sane defaults applied if unset; see
# learnings/config.py for the full list).
# LEARNINGS_HANDLE=@Working-Ant
# LEARNINGS_CALL_WORDS=learn,remember,note,teach
# LEARNINGS_THRESHOLD=0.78
# LEARNINGS_TOP_K=5
# LEARNINGS_PER_QUERY_K=5
# LEARNINGS_FILTER=1
# LEARNINGS_INTERVAL=60
