# Required for the Agent SDK reviewer
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GITHUB_REVIEW_BOT_TOKEN=ghp_your_bot_users_personal_access_token

# Required for the Learnings layer (Phase 6) — strictly additive;
# the reviewer keeps running if these are missing or unreachable.
VOYAGE_API_KEY=your_voyage_api_key_here
QDRANT_URL=https://your-cluster.us-west-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key_here

# Optional Learnings tunables (sane defaults applied if unset; see
# learnings/config.py for the full list).
# LEARNINGS_HANDLE=@Working-Ant
# LEARNINGS_CALL_WORDS=learn,remember,note,teach
# LEARNINGS_THRESHOLD=0.78
# LEARNINGS_TOP_K=5
# LEARNINGS_PER_QUERY_K=5
# LEARNINGS_FILTER=1
# LEARNINGS_INTERVAL=60
